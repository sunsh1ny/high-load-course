### Start with --spring.profiles.active=case5 (default port 8081).
### Test 1: steady overload, short deadline.
POST http://localhost:1234/test/run
Content-Type: application/json

{
  "serviceName": "{{serviceName}}",
  "token": "{{token}}",
  "ratePerSecond": 15,
  "testCount": 3000,
  "processingTimeMillis": 2500,
  "onPremises": false
}

### Test 2: varying incoming load; retain spare capacity for its peaks.
POST http://localhost:1234/test/run
Content-Type: application/json

{
  "serviceName": "{{serviceName}}",
  "token": "{{token}}",
  "ratePerSecond": 11,
  "testCount": 2200,
  "processingTimeMillis": 13000,
  "profile": "s_0.7_60",
  "onPremises": false
}

### Test 3: batches of 270 purchases every 90 seconds.
POST http://localhost:1234/test/run
Content-Type: application/json

{
  "serviceName": "{{serviceName}}",
  "token": "{{token}}",
  "ratePerSecond": 3,
  "testCount": 1050,
  "processingTimeMillis": 26000,
  "runits": 90,
  "onPremises": false
}

### Stop the current test.
POST http://localhost:1234/test/stop/{{serviceName}}
