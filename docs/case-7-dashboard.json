{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "case7-provider",
  "title": "Case 7 - Payment provider",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Provider retries sent",
      "description": "Cumulative counter since the shop started.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (account) (payment_provider_retries_total{job=\"online-store-job\",account=\"acc-7\"})",
          "legendFormat": "{{account}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Provider attempt latency and HTTP 408 rate",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "axisPlacement": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "HTTP 408/s" },
            "properties": [
              { "id": "unit", "value": "reqps" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(payment_provider_attempt_duration_seconds_bucket{job=\"online-store-job\",account=\"acc-7\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(payment_provider_attempt_duration_seconds_bucket{job=\"online-store-job\",account=\"acc-7\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum(rate(payment_provider_server_timeouts_total{job=\"online-store-job\",account=\"acc-7\"}[$__rate_interval]))",
          "legendFormat": "HTTP 408/s",
          "range": true
        }
      ]
    }
  ]
}
